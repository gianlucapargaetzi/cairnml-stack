# Copy to deploy/.env (git-ignored). bootstrap.sh does this and fills in generated secrets.
# Placeholders only: never put a real secret in this tracked file.

# ---- public URLs: identical for the host, the containers and (later) other machines ----
MLOPS_SERVER_URL=http://mlops-server:8000
MLOPS_IDP_ISSUER=http://mlops-idp:8080/realms/mlops
MLOPS_NAS_URL=http://mlops-nas:9000

# ---- idp (machine 5) ----
KC_ADMIN=kcadmin
KC_ADMIN_PASSWORD=change-me

# ---- nas (machine 3) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MLOPS_S3_ACCESS_KEY=mlops-server
MLOPS_S3_SECRET_KEY=change-me

# ---- server (machine 2) ----
POSTGRES_PASSWORD=change-me
GITHUB_APP_ID=
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# ---- agent (machine 4) ----
# Same path on the host and in the container (job containers bind-mount workspaces from here).
MLOPS_AGENT_HOME=/var/lib/mlops-agent
MLOPS_AGENT_NAME=local-agent
# Filled in after `mlops admin agent-token`; only needed for the first start.
MLOPS_AGENT_ENROLL_TOKEN=
# Wheel files that job environments install; written by bootstrap.sh.
MLOPS_AGENT_CLIENT_PIP_SPEC=
