# Copied to deploy/.env by scripts/bootstrap.sh (git-ignored), which fills in the generated password.
# Placeholders only: never put a real secret in this tracked file.

# Sign-in (Keycloak). One admin login for Keycloak's master realm and the ClearML realm.
KC_ADMIN=kcadmin
KC_ADMIN_PASSWORD=change-me

# Object storage (RustFS). The root user is used once, by the storage init job; the server
# uses MLOPS_S3_ACCESS_KEY with the secret in secrets/clearml/s3_secret_key (written by bootstrap.sh).
RUSTFS_ROOT_USER=rustfsadmin
RUSTFS_ROOT_PASSWORD=change-me
MLOPS_S3_ACCESS_KEY=mlops-server
# The address clients use to reach object storage. Presigned URLs name this host, so it must be
# reachable from every client. Use the server's LAN name or IP when clients are on other machines.
MLOPS_STORAGE_PUBLIC_URL=http://localhost:9000

# ClearML server. Optional: the GitHub App (see README, "GitHub App") and the cookie setting for https.
GITHUB_APP_ID=
GITHUB_API_URL=https://api.github.com
# Set to true only when the ClearML addresses are https.
CLEARML_COOKIE_SECURE=false
# The forks of clearml-server and clearml-web, if they are not next to this repository.
