# Copied to deploy/.env by scripts/bootstrap.sh (git-ignored), which fills in the generated password.
# Placeholders only: never put a real secret in this tracked file.

# Sign-in (Keycloak). One admin login for Keycloak's master realm and the ClearML realm.
KC_ADMIN=kcadmin
KC_ADMIN_PASSWORD=change-me

# ClearML server. Optional: the GitHub App (see README, "GitHub App") and the cookie setting for https.
GITHUB_APP_ID=
GITHUB_API_URL=https://api.github.com
# Set to true only when the ClearML addresses are https.
CLEARML_COOKIE_SECURE=false
# The forks of clearml-server and clearml-web, if they are not next to this repository.
CLEARML_SERVER_SRC=../../../mlops-clearml/clearml-server
CLEARML_WEB_SRC=../../../mlops-clearml/clearml-web
