{
  "realm": "mlops",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": { "realm": [ { "name": "mlops-admin", "description": "May create agent enrollment tokens, projects and revoke machines" } ] },
  "clients": [
    {
      "clientId": "mlops-cli",
      "name": "mlops command line client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": { "oauth2.device.authorization.grant.enabled": "true" }
    }
  ]
}
